<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.cs')) != 'true'">true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="EasyAssertions" Version="4.0.0" />
    <PackageVersion Include="editorconfig" Version="0.18.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.12" />
    <PackageVersion Include="DotNetDo.Core" Version="0.6.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
</Project>
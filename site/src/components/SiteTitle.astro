---
// Overrides Starlight's SiteTitle to add the ways into the docs beside it on pages without a sidebar, so the landing
// page still has them once its hero has scrolled away. The title is the one part of the header shown at every width.
import Default from "@astrojs/starlight/components/SiteTitle.astro";

const { hasSidebar } = Astro.locals.starlightRoute;
// Absolute, because the 404 page is served at whatever path went missing.
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const links = [
  { label: "Guides", href: `${base}getting-started/` },
  { label: "Rules", href: `${base}rules/` },
];
---

<Default />
{
  !hasSidebar && (
    <nav aria-label="Documentation">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  )
}

<style>
  nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-inline-start: 1.25rem;
    padding-inline-start: 1.25rem;
    border-inline-start: 1px solid var(--sl-color-gray-5);
  }
  a {
    color: var(--sl-color-gray-2);
    font: 600 .75rem var(--mono);
    letter-spacing: .12em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }
  a:hover { color: var(--sl-color-accent); }

  /* A phone's header also has to hold the search button beside these. */
  @media (max-width: 50rem) {
    nav { gap: .9rem; margin-inline-start: .75rem; padding-inline-start: .75rem; }
    a { letter-spacing: .06em; }
  }
  /* The narrowest phones keep the logo and leave the name to screen readers, rather than clip it. */
  @media (max-width: 23rem) {
    :global(.site-title:has(+ nav) span) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>

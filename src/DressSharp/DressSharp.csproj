<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>DressSharp</AssemblyName>
    <RootNamespace>DressSharp</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-dress</ToolCommandName>
    <PackageId>DressSharp</PackageId>
    <Version>0.1.0</Version>
    <Authors>Simon Oxtoby</Authors>
    <Description>A syntax-only, explicitly configured C# formatter.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\packages</PackageOutputPath>
    <!-- Formatting a repository allocates syntax nodes on every worker at once, and collection was
         measured at roughly a third of active CPU under the workstation collector. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="editorconfig" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="InteractiveWeb/dist/index.html" LogicalName="DressSharp.Interactive.index.html" />
    <EmbeddedResource Include="InteractiveWeb/dist/app.js" LogicalName="DressSharp.Interactive.app.js" />
    <EmbeddedResource Include="InteractiveWeb/dist/app.css" LogicalName="DressSharp.Interactive.app.css" />
  </ItemGroup>
  <Target Name="RequireInteractiveAssets" BeforeTargets="PrepareForBuild"
          Condition="!Exists('InteractiveWeb/dist/index.html') Or !Exists('InteractiveWeb/dist/app.js') Or !Exists('InteractiveWeb/dist/app.css')">
    <Error Text="Interactive browser assets are missing. Run 'dotnet do build-interactive' before building DressSharp." />
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="DressSharp.UnitTests" />
    <InternalsVisibleTo Include="DressSharp.IntegrationTests" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>DressSharp</AssemblyName>
    <RootNamespace>DressSharp</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-dress</ToolCommandName>
    <PackageId>DressSharp</PackageId>
    <Version>0.1.0</Version>
    <Authors>Simon Oxtoby</Authors>
    <Description>A syntax-only, explicitly configured C# formatter.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\packages</PackageOutputPath>
    <!-- Formatting a repository allocates syntax nodes on every worker at once, and collection was
         measured at roughly a third of active CPU under the workstation collector. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- A run is one short burst of allocation across every processor. Letting the collector
         discover that shape costs more than the memory holding every heap open saves: a thousand
         files finish in about nine tenths of the time with the adaptation turned off. -->
    <GarbageCollectionAdaptationMode>0</GarbageCollectionAdaptationMode>
    <!-- Guided optimization watches code run so that it can compile it better the second time. A
         run reads each file once and exits, so the watching is paid for and the better code is
         barely reached: a thousand files finish in about five sixths of the time without it, and
         three files finish faster too. -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="editorconfig" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="InteractiveWeb/dist/index.html" LogicalName="DressSharp.Interactive.index.html" />
    <EmbeddedResource Include="InteractiveWeb/dist/app.js" LogicalName="DressSharp.Interactive.app.js"
                      Condition="'$(Configuration)' != 'Release'" />
    <EmbeddedResource Include="InteractiveWeb/dist/app.js.gz" LogicalName="DressSharp.Interactive.app.js.gz"
                      Condition="'$(Configuration)' == 'Release'" />
    <EmbeddedResource Include="InteractiveWeb/dist/app.css" LogicalName="DressSharp.Interactive.app.css" />
  </ItemGroup>
  <Target Name="RequireInteractiveAssets" BeforeTargets="PrepareForBuild"
          Condition="!Exists('InteractiveWeb/dist/index.html') Or !Exists('InteractiveWeb/dist/app.css')
                     Or ('$(Configuration)' == 'Release' And !Exists('InteractiveWeb/dist/app.js.gz'))
                     Or ('$(Configuration)' != 'Release' And !Exists('InteractiveWeb/dist/app.js'))">
    <Error Text="Interactive browser assets are missing. Run 'dotnet do build-interactive' before building DressSharp." />
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="DressSharp.UnitTests" />
    <InternalsVisibleTo Include="DressSharp.IntegrationTests" />
  </ItemGroup>
</Project>
